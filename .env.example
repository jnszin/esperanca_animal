# ==========================================
# ESPERANÇA ANIMAL - VARIÁVEIS DE AMBIENTE (.env)
# ==========================================

# 1. Banco de Dados PostgreSQL (VPS Hostinger Linux)
DATABASE_URL="postgresql://usuario:senha@ip_da_vps:5432/esperanca_db?schema=public"

# 2. Autenticação (Auth.js v5 / NextAuth)
AUTH_SECRET="gere_uma_chave_aleatoria_com_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"

# 3. Segurança de Webhooks (Edge Middleware)
WEBHOOK_SECRET="segredo_para_o_header_x_webhook_secret"

# 4. Mensageria & Automação (n8n na VPS)
N8N_WEBHOOK_URL="https://n8n.sua-ong.org.br/webhook"
N8N_API_KEY=""

# 5. Cloudflare R2 (S3-Compatible Storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="esperanca-animal"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# 6. Gateway de Doações Pix (ex: Asaas, Mercado Pago, EFI)
PIX_API_URL="https://api.gateway.com/v1"
PIX_API_KEY=""
PIX_CHAVE_CHAVE=""
